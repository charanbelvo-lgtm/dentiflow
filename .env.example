MYSQL_HOST=your_mysql_internal_hostname
MYSQL_PORT=3306
MYSQL_DATABASE=dentiflow
MYSQL_USER=dentiflow_user
MYSQL_PASSWORD=your_secure_password
SECRET_KEY=replace_with_a_long_random_secret
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1

# Optional Firebase Cloud Integration
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=dentiflow-app.firebaseapp.com
FIREBASE_PROJECT_ID=dentiflow-app
FIREBASE_STORAGE_BUCKET=dentiflow-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
